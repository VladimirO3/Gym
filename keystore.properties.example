# Шаблон файла подписи release-сборки.
# Скопируйте в корень проекта как keystore.properties (файл в .gitignore, НЕ коммитить)
# и заполните своими значениями.
#
# storeFile — путь к keystore относительно корня проекта (или абсолютный)
# storePassword / keyPassword — пароли keystore и ключа
# keyAlias — алиас ключа (при создании выше указывался: gym)
storeFile=gym-release.jks
storePassword=CHANGE_ME
keyAlias=gym
keyPassword=CHANGE_ME
